# ---------------------------------------------------------------------------
# LabGuard AI — environment template
#
# Copy to `.env` and fill in. Everything here has a working default for demo
# mode, so the whole claim-to-verdict workflow runs with none of it set.
# ---------------------------------------------------------------------------

# --- topology --------------------------------------------------------------
# "demo"  : in-process job bus, in-memory store, local artifacts, rule engine.
# "cloud" : Firestore, Pub/Sub, Cloud Storage and Gemini through Google ADK.
LABGUARD_MODE=demo

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1

# --- Gemini ----------------------------------------------------------------
# Either set GOOGLE_API_KEY for the Gemini Developer API, or set
# GOOGLE_GENAI_USE_VERTEXAI=true and rely on the Cloud Run service account.
# Leave both unset and LabGuard runs the deterministic rule engine instead.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false

# The primary model id. If the deployment does not expose this exact id,
# LabGuard falls through GEMINI_MODEL_FALLBACKS in order rather than failing.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_FALLBACKS=gemini-flash-latest,gemini-2.5-flash

# --- Google Cloud infrastructure -------------------------------------------
FIRESTORE_DATABASE=(default)
FIRESTORE_ROOT=labguard_claims
PUBSUB_JOBS_TOPIC=labguard-jobs
PUBSUB_EVENTS_TOPIC=labguard-events
GCS_BUCKET=
ENABLE_CLOUD_LOGGING=false

# Shared secret the worker's Pub/Sub push endpoint requires. Leave empty to
# disable the check (only appropriate for local development).
WORKER_SHARED_SECRET=

# --- behaviour -------------------------------------------------------------
# Artifacts go to GCS_BUCKET in cloud mode; this is the local fallback.
ARTIFACT_DIR=./artifacts
# Simulated queue latency, so demo runs show real queued -> running transitions.
SIMULATED_QUEUE_LATENCY=0.6
MAX_PLANNING_ROUNDS=4
CORS_ORIGINS=*

# --- dashboard -------------------------------------------------------------
# Where the Next.js rewrite forwards /api/backend/* .
LABGUARD_API_URL=http://127.0.0.1:8080
